@using CleanArchitecture.Infrastructure.Services
@model MobileNumberRegister
@{
    // The header button links here instead of opening the modal, so the form is not on the page twice
    ViewData["AuthPage"] = true;
    ViewData["AuthStart"] = Context.Request.Query["mode"] == "register" ? "register" : "login";
}

<section class="nms-auth-page">
    <div data-auth-redirect="@Url.Action("Index", "Home")" class="w-100">
        <partial name="_AuthForms" />
    </div>
</section>
