@namespace CleanArchitecture.Application.PagesDto
@using CleanArchitecture.Infrastructure.Identity;
@using CleanArchitecture.Application.Common.Interfaces;
@model IndexDto
@inject IIdentityService IdentityService
@{
    ViewData["HomeHero"] = true;
}
<!DOCTYPE html>
<html lang="en" dir="rtl">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">

    <title>آزمایشگاه نانو مواد صبا</title>
    <meta content="" name="description">
    <meta content="" name="keywords">

    <!-- Favicons -->
    <link href="../img/favicon.png" rel="icon">
    <link href="../img/apple-touch-icon.png" rel="apple-touch-icon">
    <!-- Vendor CSS Files -->
    <link href="../vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="../vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
    <link href="../vendor/glightbox/css/glightbox.min.css" rel="stylesheet">
    <link href="../vendor/swiper/swiper-bundle.min.css" rel="stylesheet">
    <!-- Template Main CSS File -->
    <link href="../css/main.css" rel="stylesheet">
    <link href="../vendor/aos/aos.css" rel="stylesheet">
    <script src="../vendor/aos/aos.js"></script>
</head>

<body>


    <!-- End Header -->
    <!-- ======= Hero Section ======= -->
    <section id="hero" class="nms-hero">
        <div class="container-xl">
            <div class="nms-hero__card">
                <picture>
                    <source srcset="../img/MainImage/hero-lab.webp" type="image/webp">
                    <img class="nms-hero__bg" src="../img/MainImage/hero-lab.jpg" alt="دستگاه آنالیز در آزمایشگاه نانو مواد صبا" fetchpriority="high">
                </picture>
                <div class="nms-hero__content">
                    <p class="nms-hero__eyebrow" dir="ltr">ADVANCED MATERIALS ANALYSIS LABORATORY</p>
                    <h1 class="nms-hero__title">
                        آنالیزهای تخصصی با
                        <span>تکنولوژی روز دنیا</span>
                    </h1>
                    <p class="nms-hero__lead">
                        با بهره گیری از پیشرفته ترین تجهیزات و تیم متخصص
                        آنالیز دقیق و قابل اعتماد مواد را برای شما فراهم می کنیم.
                    </p>
                    <div class="nms-hero__buttons">
                        <a class="btn nms-btn nms-btn--primary nms-btn--lg" asp-controller="Analysis" asp-action="Index">
                            ثبت سفارش
                            <i class="bi bi-arrow-left"></i>
                        </a>
                    </div>
                </div>
            </div>
            <ul class="nms-features">
                <li class="nms-feature">
                    <span class="nms-feature__icon"><i class="bi bi-bullseye"></i></span>
                    <span class="nms-feature__text">
                        <strong>دقت و کیفیت</strong>
                        <small>نتایج دقیق و قابل اعتماد</small>
                    </span>
                </li>
                <li class="nms-feature">
                    <span class="nms-feature__icon"><i class="bi bi-cpu"></i></span>
                    <span class="nms-feature__text">
                        <strong>تجهیزات پیشرفته</strong>
                        <small>به روزترین دستگاه های آنالیز</small>
                    </span>
                </li>
                <li class="nms-feature">
                    <span class="nms-feature__icon"><i class="bi bi-clipboard-check"></i></span>
                    <span class="nms-feature__text">
                        <strong>صحت</strong>
                        <small>رعایت استانداردهای بین المللی</small>
                    </span>
                </li>
                <li class="nms-feature">
                    <span class="nms-feature__icon"><i class="bi bi-headset"></i></span>
                    <span class="nms-feature__text">
                        <strong>پشتیبانی تخصصی</strong>
                        <small>مشاوره و راهنمایی کامل</small>
                    </span>
                </li>
                <li class="nms-feature">
                    <span class="nms-feature__icon"><i class="bi bi-lightning-charge"></i></span>
                    <span class="nms-feature__text">
                        <strong>سرعت بالا</strong>
                        <small>تحویل در کوتاه ترین زمان</small>
                    </span>
                </li>
            </ul>
        </div>
    </section>
    <!-- End Hero Section -->

    <main id="main">

        <!-- ======= Lab Services Section ======= -->
        <section class="nms-services">
            <div class="container-xl">
                <div class="nms-services__grid">
                    <div class="nms-services__text">
                        <h2 class="nms-section-title">خدمات تست آزمایشگاهی</h2>
                        <p class="nms-services__body">
                            آزمایشگاه تحقیقاتی شناسایی نانو مواد صبا با کادری مجرب از کارشناسان و مهندسین
                            حوزه آنالیز و نانوتکنولوژی، آماده ی ارائه خدمات آنالیزی اعم از سنجش سطح مواد
                            متخلخل (آنالیز BET) و آنالیز شناسایی ترکیبات آلی به کمک آنالیز FTIR و آنالیز GC-MS
                            و همچنین آنالیز های مواد معدنی چون آنالیز ICP-MS، آنالیز ICP-OES، آنالیز XRF،
                            آنالیز XRD و تعیین غلظت فلزات گرانبها به کمک Fire Assay به جامعه علمی کشور،
                            دانشگاه ها، کارخانجات، شرکت های دانش بنیان و شرکت های اکتشاف و استخراج معادن
                            می باشد. همچنین این آزمایشگاه یکی از آزمایشگاه های فعال در حوزه شناسایی مواد مجهول،
                            مشکوک، افزودنی ها، رنگ، پلیمرها، پوشش وعمده ی مواد تجاری شیمیایی وترکیبات مخلوط مورد
                            استفاده در کارگاه ها و کارخانجات تولیدی و مهندسی معکوس به وسیله آنالیز FTIR و جستجوی
                            کتابخانه ای مواد تحت آنالیز به کمک Bio Rad و KnowItAll است.
                        </p>
                    </div>
                    <div class="nms-services__media">
                        <img class="nms-services__img" src="../img/MainImage/home-microscope.jpg" alt="عدسی میکروسکوپ آزمایشگاه" loading="lazy" width="457" height="388">
                    </div>
                </div>
            </div>
        </section>
        <!-- End Lab Services Section -->

        <!-- ======= Featured Products Section ======= -->
        <section class="nms-products">
            <div class="container-xl">
                <div class="nms-products__head">
                    <h2 class="nms-section-title">پیشنهاد ویژه</h2>
                    <span class="nms-products__line"></span>
                    <a class="nms-products__all" asp-controller="Analysis" asp-action="Index">
                        مشاهده همه
                        <i class="bi bi-arrow-left"></i>
                    </a>
                </div>
                <ul class="nms-products__list">
                    @foreach (var device in new[]
                    {
                        ("TEM", "TEM.png", "میکروسکوپ الکترونی عبوری"),
                        ("XRD", "XRD.png", "آنالیز طیف سنجی پراش پرتو ایکس"),
                        ("BET", "BET.png", "آنالیز سطح سنجی به روش ایزوترم جذب و واجذب گاز نیترون (N2)"),
                        ("ICP-MS", "ICP-MS.png", "آنالیز طیف سنجی جرمی پلاسما جفت شده القایی"),
                        ("XRF", "XRF.png", "آنالیز فلورسانس اشعه ایکس")
                    })
                    {
                        <li class="nms-product">
                            <div class="nms-product__img">
                                <img src="../img/@device.Item2" alt="دستگاه @device.Item1" loading="lazy" width="585" height="470">
                            </div>
                            <div class="nms-product__body">
                                <h3>
                                    <a class="stretched-link" href="@Url.Action("DeviceById", "Device", new { myParams = device.Item1 })">آنالیز @device.Item1</a>
                                    <i class="bi bi-arrow-left" aria-hidden="true"></i>
                                </h3>
                                <p>@device.Item3</p>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        </section>
        <!-- End Featured Products Section -->

        <!-- ======= Articles Section ======= -->
        
        
        <component type="typeof(NanoSaba.Components.OrderSteps)"
                   render-mode="ServerPrerendered" />

        <component type="typeof(NanoSaba.Components.ArticleList)"
                   render-mode="Static" />


        <!-- ======= About Section ======= -->
        <section class="nms-about">
            <div class="container-xl">
                <div class="nms-products__head">
                    <h2 class="nms-section-title">درباره ی ما</h2>
                    <span class="nms-products__line"></span>
                </div>
                <div class="nms-about__grid">
                    <div class="nms-about__media">
                        <img src="../img/MainImage/home-pipette.jpg" alt="کارشناس آزمایشگاه در حال کار با پیپت" loading="lazy" width="494" height="328">
                    </div>
                    <div class="nms-about__card">
                        <p>
                            این آزمایشگاه با فعالیت برجسته در حوزه ساخت دستگاه BET و تعیین استاندارد این آنالیز، یکی از برترین آزمایشگاه ها در آنالیز BET است.
                            با توجه به تجربه کاری در آنالیز مواد مجهول (ناشناخته) و در حال ساخت (مهندسی معکوس مواد پیشرفته و پلیمری ) با استفاده از دستگاه FTIR
                            و جستجوی کتابخانه ای BIORAD و KNOWiTAll در شناخت اجزا و افزودنی ها (Additive) در ارائه خدمات آزمایشگاهی به جامعه علمی کشور اعلام آمادگی می نماییم.
                            از طرفی با در نظر داشتن نیاز علمی کشور به شناسایی ترکیبات مشکوک در حوزه جرائم و پزشکی قانونی، همچنین صنعت بیمه، مفتخریم با ارائه کیت های تشخیص مواد انفجاری،
                            مخدر و سموم غذایی به هر چه آسان تر شدن بخش تحقیقات این سازمان ها کمک شایانی نماییم.
                        </p>
                        <ul class="nms-about__stats">
                            <li><strong>+550</strong><span>مشتریان راضی از آزمایشگاه صبا نانو</span></li>
                            <li><strong>+20</strong><span>سال تجربه</span></li>
                            <li><strong>15</strong><span>دستگاه های آماده برای آنالیز</span></li>
                        </ul>
                    </div>
                </div>
                <p class="nms-about__goal">
                    هدف آزمایشگاه نانو مواد صبا بررسی و تحلیل داده های آنالیزی به صورت دقیق و علمی می باشد که با استفاده از کادری مجرب و با تجربه در زمینه آنالیز مواد،
                    توانسته ایم رضایت متقاضیان را در حد بسیار قابل قبولی ایجاد نماییم. این آزمایشگاه در زمینه آنالیز مواد معدنی با آنالیز های XRD، XRF، AAS و ICP-MS و ICP-OES ،
                    در زمینه آنالیز فلزات گرانبها به کمک روش Fire Assay و در زمینه مواد آلی با استفاده از دستگاه FTIR و GC-MS آماده خدمت رسانی می باشد.
                </p>
            </div>
        </section>
        <!-- End About Section -->

    </main><!-- End #main -->

</body>

</html>