<!DOCTYPE html>
<html lang="en" dir="rtl">
@using CleanArchitecture.Application.Common.Interfaces;
@using CleanArchitecture.Infrastructure.Common
@using CleanArchitecture.Infrastructure.Identity;
@using Microsoft.AspNetCore.Identity;
@using System.Security.Claims;
@using CleanArchitecture.Application.Orders
@model BaseViewModel
@inject SignInManager<ApplicationUser> SignInManager
@inject ICurrentUserService CurrentUser
@inject IOrderService Order
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>آزمایشگاه نانو مواد صبا</title>
    <meta content="" name="description">
    <meta content="" name="keywords">
    <link href="../img/logo.png" rel="icon">
    <link href=" ../apple-touch-icon.png" rel="apple-touch-icon">
    <link href="../vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="../vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
    <link href="../vendor/glightbox/css/glightbox.min.css" rel="stylesheet">
    <link href="../vendor/swiper/swiper-bundle.min.css" rel="stylesheet">
    <link href="../css/main.css" rel="stylesheet">
    <link href="~/css/nms-home.css" rel="stylesheet" asp-append-version="true">
</head>

<body>

<!-- ======= Header ======= -->
<header id="header" class="nms-header@(ViewData["HomeHero"] is true ? " nms-header--home" : "")">
    <div class="container-xl nms-header__inner">
        <div class="nms-header__actions">
            <a class="btn nms-btn nms-btn--primary" asp-controller="Analysis" asp-action="Index">ثبت سفارش</a>
            @if (!SignInManager.IsSignedIn(User))
            {
                <a class="btn nms-btn nms-btn--outline" href="@Url.Action("SignIn", "Home")">ورود</a>
            }
            else
            {
                <div class="dropdown">
                    <button class="btn nms-btn nms-btn--outline dropdown-toggle" type="button" id="dropdownMenu2" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-person-fill"></i>
                        @if (Order.InitialExist())
                        {
                            <span class="badge bg-danger">@Order.InitialCount()</span>
                        }
                    </button>
                    <ul class="dropdown-menu dropdown-menu-start" aria-labelledby="dropdownMenu2">
                    <li>
                        <button class="dropdown-item align-items-start justify-content-start ml-auto pull-right d-flex" type="button"
                                onclick="window.open('@Url.ActionLink("Index", "Profile", new { })')">
                            <i class="bi bi-person  mx-2"> </i>
                            @CurrentUser.FullName
                        </button>
                    </li>
                    @* @if (CurrentUser.UserName is not null && *@
                    @*      (CurrentUser.UserName.Equals("09124798930") || *@
                    @*       CurrentUser.UserName.Equals("09129366624") || *@
                    @*       CurrentUser.UserName.Equals("09215628768") || *@
                    @*       CurrentUser.UserName.Equals("09108343551"))) *@
                    @* { *@
                        <li>
                            <button class="dropdown-item align-items-start justify-content-start ml-auto pull-right d-flex" type="button"
                                    onclick="window.open('@Url.ActionLink("Index", "OrderCart", new { })')">
                                <i class="bi bi-cart3  mx-2"></i>
                                سبد خرید
                                @if (Order.InitialExist())
                                {
                                    <span class="badge bg-danger mx-2">
                                        @Order.InitialCount()
                                    </span>
                                }
                            </button>
                        </li>
                        <li>
                            <button class="dropdown-item align-items-start justify-content-start ml-auto pull-right d-flex" type="button"
                                    onclick="window.open('@Url.ActionLink("Index", "Order", new { })')">
                                <i class="bi bi bi-bag-heart  mx-2"></i>
                                سفارشات
                            </button>
                        </li>
                    @* } *@
                    <li>
                        <button class="dropdown-item align-items-start justify-content-start ml-auto pull-right d-flex" type="button"
                                onclick="window.open('@Url.ActionLink("Logout", "Home", new { })')">
                            <i class="bi bi-box-arrow-in-right  mx-2"> </i>
                            خروج از حساب کاربری
                        </button>
                    </li>
                </ul>
                </div>
            }
            <a class="nms-header__search" asp-controller="Analysis" asp-action="Index" aria-label="جستجوی خدمات آنالیز">
                <i class="bi bi-search"></i>
            </a>
        </div>

        <nav id="navbar" class="navbar nms-nav">
            <ul>
                <li><a asp-controller="Home" asp-action="Index">صفحه اصلی</a></li>
                <li><a asp-controller="Analysis" asp-action="Index">خدمات آنالیز</a></li>
                <li><a asp-controller="Articles" asp-action="Index">مقالات</a></li>
                <li><a asp-controller="Home" asp-action="About">درباره ما</a></li>
                <li><a asp-controller="Home" asp-action="Contact">تماس با ما</a></li>
            </ul>
        </nav><!-- .navbar -->

        <a class="nms-brand" asp-controller="Home" asp-action="Index">
            <img src="../img/nms-logo.svg" alt="" width="46" height="52"/>
            <span class="nms-brand__text">
                <span class="nms-brand__name">NMS</span>
                <span class="nms-brand__sub">نانو مواد صبا</span>
            </span>
        </a>

        <i class="mobile-nav-toggle mobile-nav-show bi bi-list"></i>
        <i class="mobile-nav-toggle mobile-nav-hide d-none bi bi-x"></i>
    </div>
</header><!-- End Header -->
<div>
    <main role="main" class="pb-3">
        @RenderBody()
        @if (@Model?.IsSuccess is false)
        {
            <div class="alert alert-danger mx-4 mt-2 col-md-3 d-flex justify-content-start" id="selectCodeNotificationArea" role="alert">
                <a type="button" onclick="CloseAlert()" class="close mx-4" data-hide="alert">&times;</a>
                @Model?.Message
            </div>
        }
    </main>

</div>

<footer id="footer" class="nms-footer">
    <div class="container-xl">
        <div class="nms-footer__grid">

            <!-- Brand -->
            <div class="nms-footer__brand">
                <a class="nms-footer__logo" asp-controller="Home" asp-action="Index">
                    <img src="../img/nms-logo.svg" alt="" width="56" height="64" />
                    <span class="nms-footer__name">NMS</span>
                    <span class="nms-footer__sub" dir="ltr">SABA<br>NANOMAVAD</span>
                </a>
                <p class="nms-footer__tagline" dir="ltr">ADVANCED MATERIALS ANALYSIS LABORATORY</p>
                <div class="nms-footer__social">
                    <a href="#" aria-label="تلگرام"><i class="bi bi-telegram"></i></a>
                    <a href="#" aria-label="اینستاگرام"><i class="bi bi-instagram"></i></a>
                    <a href="#" aria-label="فیسبوک"><i class="bi bi-facebook"></i></a>
                    <a href="#" aria-label="لینکدین"><i class="bi bi-linkedin"></i></a>
                </div>
            </div>

            <!-- Quick links -->
            <div class="nms-footer__col">
                <h4>دسترسی سریع</h4>
                <ul>
                    <li><a asp-controller="Home" asp-action="Index">صفحه اصلی</a></li>
                    <li><a asp-controller="OrderGuide" asp-action="Index">نحوه ی ثبت سفارش</a></li>
                    <li><a asp-controller="Articles" asp-action="Index">مقالات آنالیز</a></li>
                    <li><a asp-controller="Home" asp-action="About">درباره ی ما</a></li>
                    <li><a asp-controller="Home" asp-action="Contact">تماس با ما</a></li>
                    <li><a asp-controller="Analysis" asp-action="Index">خدمات آنالیز</a></li>
                </ul>
            </div>

            <!-- Analysis services -->
            <div class="nms-footer__col">
                <h4>خدمات آنالیز</h4>
                <ul>
                    <li><a asp-controller="Analysis" asp-action="Index">آنالیز عنصری</a></li>
                    <li><a asp-controller="Analysis" asp-action="Index">آنالیز تصویر برداری</a></li>
                    <li><a asp-controller="Analysis" asp-action="Index">آنالیز حرارتی</a></li>
                    <li><a asp-controller="Analysis" asp-action="Index">کروماتوگرافی</a></li>
                    <li><a asp-controller="Analysis" asp-action="Index">آنالیز اسپکتروسکوپی</a></li>
                    <li><a asp-controller="Analysis" asp-action="Index">آنالیز سطح ویژه</a></li>
                    <li><a asp-controller="Analysis" asp-action="Index">آنالیز سطح سنج</a></li>
                </ul>
            </div>

            <!-- Contact -->
            <div class="nms-footer__col nms-footer__contact">
                <h4>تماس با ما</h4>
                <ul>
                    <li>
                        <i class="bi bi-geo-alt"></i>
                        <span>
                            طرشت، میدان شهید تیموری، خیابان لطفعلی خانی،
                            انتهای خیابان پارس، خیابان ذوقی، پلاک ۲۲، واحد ۲<br>
                            کد پستی: ۱۴۵۹۸۷۳۱۶۷
                        </span>
                    </li>
                    <li>
                        <i class="bi bi-telephone"></i>
                        <span dir="ltr">
                            <a href="tel:02166519666">021-66519666</a><br>
                            <a href="tel:09122199232">09122199232</a>
                        </span>
                    </li>
                    <li>
                        <i class="bi bi-envelope"></i>
                        <a href="mailto:info.saba.analyze@gmail.com">info.saba.analyze@gmail.com</a>
                    </li>
                    <li>
                        <i class="bi bi-clock"></i>
                        <span>شنبه تا چهارشنبه: ساعت ۰۸:۳۰ تا ۱۷:۰۰</span>
                    </li>
                </ul>
            </div>

        </div>
    </div>
</footer>
<!-- End Footer -->
<!-- </div> -->

<a href="#" class="scroll-top d-flex align-items-center justify-content-center">
    <i class="bi bi-arrow-up-short"></i>
</a>

@* <div id="preloader"></div> *@
@* *@
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="../vendor/glightbox/js/glightbox.min.js"></script>
<script src="../vendor/purecounter/purecounter_vanilla.js"></script>
<script src="../vendor/swiper/swiper-bundle.min.js"></script>
<script src="../vendor/isotope-layout/isotope.pkgd.min.js"></script>
<script src="../vendor/php-email-form/validate.js"></script>
<script src="~/js/main.js" asp-append-version="true"></script>
<script type="text/javascript">

    function CloseAlert() {
        console.log("salam");
        document.getElementById('selectCodeNotificationArea').style.display = 'none';
    }

    window.setTimeout(function () {
        $(".alert").fadeTo(500, 0).slideUp(500, function () {
            $(this).remove();
        });
    }, 4000);

</script>

</body>

</html>