<!DOCTYPE html>
<html lang="en" dir="rtl">
@using CleanArchitecture.Application.Common.Interfaces;
@using CleanArchitecture.Infrastructure.Common
@using CleanArchitecture.Infrastructure.Identity;
@using Microsoft.AspNetCore.Identity;
@using System.Security.Claims;
@using CleanArchitecture.Application.Orders
@model BaseViewModel
@inject SignInManager<ApplicationUser> SignInManager
@inject ICurrentUserService CurrentUser
@inject IOrderService Order
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>آزمایشگاه نانو مواد صبا</title>
    <meta content="" name="description">
    <meta content="" name="keywords">
    <link href="../img/logo.png" rel="icon">
    <link href=" ../apple-touch-icon.png" rel="apple-touch-icon">
    <link href="../vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="../vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
    <link href="../vendor/glightbox/css/glightbox.min.css" rel="stylesheet">
    <link href="../vendor/swiper/swiper-bundle.min.css" rel="stylesheet">
    <link href="../css/main.css" rel="stylesheet">
    <link href="../css/nms-home.css" rel="stylesheet" asp-append-version="true">
</head>

<body>

<!-- ======= Header ======= -->
<header id="header" class="nms-header@(ViewData["HomeHero"] is true ? " nms-header--home" : "")">
    <div class="container-xl nms-header__inner">
        <div class="nms-header__actions">
            <a class="btn nms-btn nms-btn--primary" href="../Home/#portfolio">ثبت سفارش</a>
            @if (!SignInManager.IsSignedIn(User))
            {
                <a class="btn nms-btn nms-btn--outline" href="@Url.Action("SignIn", "Home")">ورود</a>
            }
            else
            {
                <div class="dropdown">
                    <button class="btn nms-btn nms-btn--outline dropdown-toggle" type="button" id="dropdownMenu2" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-person-fill"></i>
                        @if (Order.InitialExist())
                        {
                            <span class="badge bg-danger">@Order.InitialCount()</span>
                        }
                    </button>
                    <ul class="dropdown-menu dropdown-menu-start" aria-labelledby="dropdownMenu2">
                    <li>
                        <button class="dropdown-item align-items-start justify-content-start ml-auto pull-right d-flex" type="button"
                                onclick="window.open('@Url.ActionLink("Index", "Profile", new { })')">
                            <i class="bi bi-person  mx-2"> </i>
                            @CurrentUser.FullName
                        </button>
                    </li>
                    @* @if (CurrentUser.UserName is not null && *@
                    @*      (CurrentUser.UserName.Equals("09124798930") || *@
                    @*       CurrentUser.UserName.Equals("09129366624") || *@
                    @*       CurrentUser.UserName.Equals("09215628768") || *@
                    @*       CurrentUser.UserName.Equals("09108343551"))) *@
                    @* { *@
                        <li>
                            <button class="dropdown-item align-items-start justify-content-start ml-auto pull-right d-flex" type="button"
                                    onclick="window.open('@Url.ActionLink("Index", "OrderCart", new { })')">
                                <i class="bi bi-cart3  mx-2"></i>
                                سبد خرید
                                @if (Order.InitialExist())
                                {
                                    <span class="badge bg-danger mx-2">
                                        @Order.InitialCount()
                                    </span>
                                }
                            </button>
                        </li>
                        <li>
                            <button class="dropdown-item align-items-start justify-content-start ml-auto pull-right d-flex" type="button"
                                    onclick="window.open('@Url.ActionLink("Index", "Order", new { })')">
                                <i class="bi bi bi-bag-heart  mx-2"></i>
                                سفارشات
                            </button>
                        </li>
                    @* } *@
                    <li>
                        <button class="dropdown-item align-items-start justify-content-start ml-auto pull-right d-flex" type="button"
                                onclick="window.open('@Url.ActionLink("Logout", "Home", new { })')">
                            <i class="bi bi-box-arrow-in-right  mx-2"> </i>
                            خروج از حساب کاربری
                        </button>
                    </li>
                </ul>
                </div>
            }
            <a class="nms-header__search" href="../Home/#portfolio" aria-label="جستجوی خدمات آنالیز">
                <i class="bi bi-search"></i>
            </a>
        </div>

        <nav id="navbar" class="navbar nms-nav">
            <ul>
                <li><a href="../Home/#hero">صفحه اصلی</a></li>
                <li><a href="../Home/#portfolio">خدمات آنالیز</a></li>
                <li><a href="../Home/#recent-posts">مقالات</a></li>
                <li><a href="../Home/#about">درباره ما</a></li>
                <li><a href="../Home/#contact">تماس با ما</a></li>
            </ul>
        </nav><!-- .navbar -->

        <a class="nms-brand" href="../Home/">
            <img src="../img/nms-logo.svg" alt="" width="46" height="52"/>
            <span class="nms-brand__text">
                <span class="nms-brand__name">NMS</span>
                <span class="nms-brand__sub">نانو مواد صبا</span>
            </span>
        </a>

        <i class="mobile-nav-toggle mobile-nav-show bi bi-list"></i>
        <i class="mobile-nav-toggle mobile-nav-hide d-none bi bi-x"></i>
    </div>
</header><!-- End Header -->
<div>
    <main role="main" class="pb-3">
        @RenderBody()
        @if (@Model?.IsSuccess is false)
        {
            <div class="alert alert-danger mx-4 mt-2 col-md-3 d-flex justify-content-start" id="selectCodeNotificationArea" role="alert">
                <a type="button" onclick="CloseAlert()" class="close mx-4" data-hide="alert">&times;</a>
                @Model?.Message
            </div>
        }
    </main>

</div>
