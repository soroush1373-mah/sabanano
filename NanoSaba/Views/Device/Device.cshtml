@using CleanArchitecture.Application.PagesDto
@model DevicePageDto
@{
    // "d" is just a short name, so we don't write Model.AnalyzerDevice every time
    var d = Model.AnalyzerDevice;

    // The rows of the معرفی tab: label + value. The loop below draws them.
    var info = new (string Label, string? Value)[]
    {
        ("اسم", d.Name),
        ("اسم کامل", d.FullName),
        ("اسم فارسی", d.PersianName),
        ("کشور سازنده", d.Country),
        ("شرکت سازنده", d.CompanyName),
        ("مدل", d.Model),
        ("مقدار مورد نیاز از نمونه", d.RequirementSample),
        ("نوع پذیرش نمونه", d.Sample),
    };

    var hasResponses = d.Responses is { Count: > 0 };
    var hasDiscount = d.DiscountPercent is not null && d.DiscountPercent != 0;
}

<section class="nms-device">
    <div class="container">
        <div class="nms-device__grid">

            <!-- Right: device photo -->
            <div class="nms-device__photo">
                <img src="@d.MainImage" alt="دستگاه @d.Name">
            </div>

            <!-- Middle: title, tabs and the details -->
            <div class="nms-device__main">
                <h1 class="nms-device__title">آنالیز @d.Name</h1>

                <div class="nav nms-device__tabs" role="tablist">
                    <button class="nms-device__tab active" type="button" data-bs-toggle="tab" data-bs-target="#tab-info" role="tab">معرفی</button>
                    <button class="nms-device__tab" type="button" data-bs-toggle="tab" data-bs-target="#tab-attribute" role="tab">مشخصات</button>
                    <button class="nms-device__tab" type="button" data-bs-toggle="tab" data-bs-target="#tab-service" role="tab">خدمات</button>
                    @if (d.Attributes is { Count: > 0 })
                    {
                        <button class="nms-device__tab" type="button" data-bs-toggle="tab" data-bs-target="#tab-attributes" role="tab">ویژگی ها</button>
                    }
                </div>

                <div class="tab-content">
                    <div class="tab-pane fade show active" id="tab-info" role="tabpanel">
                        @foreach (var row in info)
                        {
                            <div class="nms-device__row">
                                <span class="nms-device__label">@row.Label:</span>
                                <span>@row.Value</span>
                            </div>
                        }
                    </div>

                    <div class="tab-pane fade" id="tab-attribute" role="tabpanel">
                        <div class="nms-device__row">
                            <span class="nms-device__label">توضیحات آماده سازی:</span>
                            <span>@d.DescriptionForReadyAnalyze</span>
                        </div>
                        <div class="nms-device__row">
                            <span class="nms-device__label">کاربرد:</span>
                            <span>@d.Usage</span>
                        </div>
                    </div>

                    <div class="tab-pane fade" id="tab-service" role="tabpanel">
                        @foreach (var item in d.Services)
                        {
                            <div class="nms-device__row">
                                <span class="nms-device__label">@item.Title</span>
                                <span>@item.Description</span>
                                @if (item.Price is not null)
                                {
                                    <span class="nms-device__label">قیمت:</span>
                                    <span>@String.Format("{0:N0}", item.Price) ریال</span>
                                }
                            </div>
                        }
                    </div>

                    @if (d.Attributes is { Count: > 0 })
                    {
                        <div class="tab-pane fade" id="tab-attributes" role="tabpanel">
                            @foreach (var item in d.Attributes)
                            {
                                <div class="nms-device__row">
                                    <span class="nms-device__label">@item.Title</span>
                                    <span>@item.Description</span>
                                </div>
                                foreach (var detail in item.Details)
                                {
                                    <p class="nms-device__detail"><b>&#9642; @detail.Title</b><br>@detail.Description</p>
                                }
                            }
                        </div>
                    }
                </div>

                @if (hasResponses)
                {
                    <!-- Bootstrap "collapse": clicking opens/closes #nms-responses. No extra JavaScript needed. -->
                    <button class="nms-device__more collapsed" type="button"
                            data-bs-toggle="collapse" data-bs-target="#nms-responses"
                            aria-expanded="false" aria-controls="nms-responses">
                        مشاهده فرمت پاسخگویی
                        <i class="bi bi-arrow-left"></i>
                    </button>
                }
            </div>

            <!-- Left: features, price, order button -->
            <aside class="nms-device__card">
                <ul class="nms-device__features">
                    <li><i class="bi bi-journal-check"></i> رعایت استانداردهای آنالیزی</li>
                    <li><i class="bi bi-bullseye"></i> دقت در آنالیزگیری هر آنالیز</li>
                    <li><i class="bi bi-speedometer2"></i> سرعت در انجام هر آنالیز</li>
                    <li><i class="bi bi-headset"></i> پشتیبانی در ساعات کاری</li>
                </ul>

                <div class="nms-device__price">
                    <span class="nms-device__price-label">قیمت:</span>
                    <bdi>@String.Format("{0:N0}", d.PriceWithDiscount)</bdi> ریال
                    @if (hasDiscount)
                    {
                        <div class="nms-device__discount">
                            <span class="badge bg-danger rounded-pill">@d.DiscountPercent٪</span>
                            <del><bdi>@String.Format("{0:N0}", d.Price)</bdi></del>
                        </div>
                    }
                </div>

                <a class="nms-device__order" href="@Url.Action("Index", "RegisterOrder", new { myParams = d.Name })">
                    <i class="bi bi-cart-plus"></i>
                    <span>ثبت سفارش</span>
                </a>

                @if (!string.IsNullOrEmpty(d.RegisterForm))
                {
                    <a class="nms-device__download" href="@d.RegisterForm" target="_blank">دانلود فرم آنالیز</a>
                }
            </aside>
        </div>

        @if (hasResponses)
        {
            <!-- فرمت پاسخگویی: hidden until the button above is clicked -->
            <div class="collapse" id="nms-responses">
                <div class="nms-device__responses">
                    <h2 class="nms-device__responses-title">فرمت پاسخگویی</h2>

                    @foreach (var item in d.Responses.Where(x => x.ImageId is null))
                    {
                        <p><b>&#9642; @item.Description</b></p>
                    }

                    @foreach (var item in d.Responses.Where(x => x.ImageId is not null))
                    {
                        if (!string.IsNullOrEmpty(item.Title))
                        {
                            <h3>@item.Title</h3>
                        }
                        <img src="@item.ImageUrl" class="img-fluid" alt="@item.Title" loading="lazy">
                        if (!string.IsNullOrEmpty(item.Description))
                        {
                            <p>&#9642; @item.Description</p>
                        }
                    }
                </div>
            </div>
        }
    </div>
</section>
