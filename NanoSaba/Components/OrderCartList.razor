@using CleanArchitecture.Application.People.Queries.GetPeopleWithPagination
@using CleanArchitecture.Application.TodoItems.Queries.GetPersonWithPagination
@using CleanArchitecture.Domain.ValueObjects
@using MediatR
@using CleanArchitecture.Application.People.Commands.DeleteOrder
@using Common.Exceptions
@inject IMediator Mediator

@if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}

<ul class="list-group list-group-flush">
    @foreach (var order in Orders)
    {
        <li class="list-group-item">
            <div class="row g-3 align-items-center">
                <!-- Image Section -->
                <div class="col-md-3 text-center">
                    <img src="@order.AnalyzerDevice.MainImage" class="img-fluid rounded" alt="@order.AnalyzerDevice.Name">
                </div>

                <!-- Order Details Section -->
                <div class="col-md-9">
                    <div class="card-body">
                        <div class="row mb-2">
                            <div class="col-auto text-secondary">نوع آنالیز:</div>
                            <div class="col-auto">@order.AnalyzerDevice.Name</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-auto text-secondary">وضعیت سفارش:</div>
                            <div class="col-auto">@order.OrderStatus.Title</div>
                        </div>
                        <!-- Samples Table -->
                        <div class="row mt-3">
                            <div class="table-responsive">
                                <table class="table table-bordered table-sm text-center">
                                    <thead class="table-light">
                                    <tr>
                                        <th scope="col">کد نمونه</th>
                                        <th scope="col">نام نمونه</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var analyze in order.Analyzes)
                                    {
                                        <tr>
                                            <td>@analyze.TrackingCode</td>
                                            <td>@analyze.Name</td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    <!-- Action Buttons -->
                    <div class="row mt-3">
                        <div class="col-12 d-flex justify-content-start align-items-center gap-2">
                            <a class="btn btn-sm btn-primary" href="/RegisterOrder/GetOrder?item=@order.Id&isEdit=true">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                            @if (confirmId == order.Id)
                            {
                                <span class="text-danger small">حذف شود؟</span>
                                <button class="btn btn-sm btn-danger" @onclick="() => Delete(order.Id)">بله</button>
                                <button class="btn btn-sm btn-secondary" @onclick="() => confirmId = null">خیر</button>
                            }
                            else
                            {
                               
                            <button class="btn btn-sm btn-danger" @onclick="() => confirmId = order.Id">
                            <i class="bi bi-trash"></i>
                            </button>
                            }

                        </div>
                    </div>
                </div>
            </div>
        </li>
    }
</ul>

@code {
    List<OrderBriefDto> Orders = new();
    long? confirmId;   // the order that shows "حذف شود؟" right now
    string? error;

    async Task Delete(long id)
    {
        try
        {
            await Mediator.Send(new DeleteOrderCommand { Id = id });
            Orders.RemoveAll(o => o.Id == id);   // remove it from the list, no page reload
            error = null;
        }
        catch (AppException ex)
        {
            error = ex.Message;   // e.g. "شما اجازه حذف این سفارش را ندارید"
        }
        catch (Exception)
        {
            error = "حذف انجام نشد. لطفا دوباره تلاش کنید";
        }
        confirmId = null;
    }

    protected override async Task OnInitializedAsync()
    {
        var result = await Mediator.Send(new GetOrderWithPaginationQuery()
        {
            OrderStatus = OrderStatus.Initial
        });
        Orders = result.Items;
    }
}
