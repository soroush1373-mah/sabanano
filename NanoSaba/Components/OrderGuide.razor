@page "/OrderGuide"
@page "/OrderGuide/Index"

<section id="services" class="services sections-bg">
    <div class="container" data-aos="fade-up">

        <div class="section-header">
            <h2>نحوه ی ثبت سفارش</h2>
            <p>@Intro</p>
        </div>

        <div class="row gy-4" data-aos="fade-up" data-aos-delay="100">
            @for (var i = 0; i < Steps.Count; i++)
            {
                var step = Steps[i];
                <div class="col-lg-4 col-md-6">
                    <div class="service-item position-relative">
                        <div class="icon">
                            <i class="bi @step.Icon"></i>
                        </div>
                        <h3>@(i + 1). @step.Title</h3>
                        <p>@step.Text</p>
                    </div>
                </div>
            }
        </div>

    </div>
</section>

@code {
    record Step(string Icon, string Title, string Text);

    string Intro = "ثبت سفارش در سایت، فرایندی است که شامل انتخاب خدمات آنالیزی مورد نیاز، افزودن آن به سبد خرید و پرداخت مبلغ خرید با روش پرداخت انتخابی توسط کاربر می‌شود. پس از تکمیل این فرایند، سفارش کاربر برای پردازش به بخش آنالیز ارسال شده و پس از بررسی و تأیید، ارسال می‌شود. در صبا نانو باری ثبت سفارارش باید عملیات ثبت نام تکمیل شود تا کاربران بتوانند به تاریخچه سفارشات خود دسترسی داشته باشند.";

    // The steps, in order. The number (1, 2, 3 ...) is added by the loop above.
    List<Step> Steps = new()
    {
        new("bi-activity", "ثبت نام", "در فرایند ثبت نام، کاربران اطلاعات شخصی خود را وارد می‌کنند. این اطلاعات شامل نام، نام خانوادگی، آدرس ایمیل، نام شرکت، شماره موبایل می‌شود. پس از وارد کردن این اطلاعات، بعد از ثبت نام ایمیل شما به عنوان نام کاربری در نظر گفته می شود. نام کاربری و رمز عبور باید حفاظت شده و به هیچ کسی اعلام نشود."),
        new("bi-broadcast", "انتخاب آنالیز و تکمیل فرم آن", "بعد از انتخاب آنالیزهای مورد نظر باید به ثبت اطلاعات شرایط نگه داری، شرایط پذیرش نمونه، ثبت ویژگی های آنالیز مورد نظر و توضیحات مربوطه توجه کرد. بعد پر کردن مموارد فنی شماره ملی های گرنت مورد نظر را وارد می کنید."),
        new("bi-easel", "امکان سنجی و محاسبات مالی", "بعد از ثبت اطلاعات آنالیز کارشناسان ما امکان انجام عملیات و مدت زمان انجام آن را گزارش می دهند و درصورت استفاده از گرنت قیمت آن را از قیمت آنالیز کسر نوده و نتیجه رو به کاربر اعلام می نمایند."),
        new("bi-bounding-box-circles", "پرداخت", "پرداخت به دو روش آنلاین و بارگزاری فیش پرداختی صورت می گیرد."),
        new("bi-calendar4-week", "تایید واحد مالی", "در صورت واریز با استفاده از فیش پرداختی نیازمند تایید واحد مالی برای شروع آنالیز می باشد. مدت زمان آماده سازی جواب آنالیز از لحظه ی پرداخت آنالیز می باشد."),
        new("bi-chat-square-text", "دریافت نتایج", "نتایج آنالیز در پنل سفارشات قابل دریافت است."),
    };
}
